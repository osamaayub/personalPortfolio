# Database (MongoDB Atlas or any MongoDB connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio

# Admin dashboard at /admin
ADMIN_PASSWORD=choose-a-long-passphrase
# 32+ random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=

# Contact form email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Must be a verified domain in production; defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=
